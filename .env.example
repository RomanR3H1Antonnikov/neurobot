# Скопировать этот файл в .env и заполнить реальными значениями

BOT_TOKEN=your_telegram_bot_token_here

# API-ключи агрегаторов (заполняются после получения от клиента)
AITUNNEL_API_KEY=
ROUTERAI_API_KEY=
KIE_API_KEY=
GENAPI_API_KEY=
POLZAAI_API_KEY=
BRATUHA_API_KEY=
RANVIKAPI_API_KEY=

# Telegram ID администраторов через запятую (для команды /addcredits)
ADMIN_IDS=

# Путь к файлу БД
DB_PATH=bot.db

# Провайдер оплаты YooKassa (получить в BotFather → Payments → YooKassa)
# Оставить пустым — отключает оплату картой через окно Telegram, работают только Stars
YOOKASSA_PROVIDER_TOKEN=

# Прямой API YooKassa (личный кабинет ЮKassa → Настройки → API) — для оплаты по ссылке (карта, СБП и др.)
# Оставить пустым — отключает способ оплаты "по ссылке"
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
