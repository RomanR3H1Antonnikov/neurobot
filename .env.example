# Скопировать этот файл в .env и заполнить реальными значениями

BOT_TOKEN=your_telegram_bot_token_here

# API-ключи агрегаторов (заполняются после получения от клиента)
AITUNNEL_API_KEY=
ROUTERAI_API_KEY=
KIE_API_KEY=

# Telegram ID администраторов через запятую (для команды /addcredits)
ADMIN_IDS=123456789

# Путь к файлу БД
DB_PATH=bot.db
